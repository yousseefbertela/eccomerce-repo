# Production Environment Variables Template
# Copy this to Railway environment variables

# Server
NODE_ENV=production
PORT=5002

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/angal-ecommerce?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=30d

# CORS - Your deployed frontend URL
FRONTEND_URL=https://your-frontend-domain.up.railway.app

# Email Configuration (Optional - for order confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Payment Gateway (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redis (Optional - for caching)
REDIS_URL=redis://default:password@host:port
