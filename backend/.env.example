# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server
NODE_ENV=development
PORT=5002

# Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Admin Account (Created automatically)
ADMIN_EMAIL=admin@angal.com
ADMIN_PASSWORD=your_secure_password

# EmailJS Configuration (for verification and password reset emails)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# EmailJS Service & Template IDs for Email Verification
EMAILJS_VERIFICATION_SERVICE_ID=your_verification_service_id
EMAILJS_VERIFICATION_TEMPLATE_ID=your_verification_template_id

# EmailJS Service & Template IDs for Password Reset
EMAILJS_RESET_SERVICE_ID=your_reset_service_id
EMAILJS_RESET_TEMPLATE_ID=your_reset_template_id

# EmailJS Template Variables:
# Verification template needs: {{to_email}}, {{to_name}}, {{verification_code}}
# Reset template needs: {{to_email}}, {{to_name}}, {{reset_code}}

# Frontend URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
DATABASE_URL=http://localhost:5175

# Payment (Stripe/PayPal)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
